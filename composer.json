{
    "name": "jacquestredoux/vue-login-flow",
    "description": "A Laravel package to quickly set up custom guards with Inertia.js/Vue login pages",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jacques Tredoux",
            "email": "jacques@example.com"
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/jacquestrdx123/vue-login-flow.git"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/console": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "inertiajs/inertia-laravel": "^1.0",
        "laravel/sanctum": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "JacquesTredoux\\VueLoginFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JacquesTredoux\\VueLoginFlow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JacquesTredoux\\VueLoginFlow\\VueLoginFlowServiceProvider"
            ]
        },
        "class": "JacquesTredoux\\VueLoginFlow\\Installer\\PackageInstaller"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

